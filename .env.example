# Supabase PostgreSQL connection. Use the connection details from Supabase.
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=replace-with-your-database-password
DB_HOST=replace-with-your-supabase-host
DB_PORT=5432
DB_SSLMODE=require

# Generate unique values locally; do not reuse these example values.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PII_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
CPF_INDEX_KEY=replace-with-a-long-random-key
