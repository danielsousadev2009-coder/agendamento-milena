# Use the Supabase PostgreSQL connection pooler URL (port 6543 for transaction mode).
DATABASE_URL=postgresql://postgres.PROJECT_REF:replace-with-database-password@pooler-host.supabase.com:6543/postgres?sslmode=require

# Supabase pooler TLS encryption; use verify-full plus DB_SSL_CA (Base64) to validate the server CA.
DB_SSLMODE=require
# DB_SSL_CA=

# Independent 32+ byte secret; generate with node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-bytes
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
PG_POOL_MAX=1

# Keep the exact existing values while migrating the current database.
PII_ENCRYPTION_KEY=replace-with-the-existing-fernet-key
CPF_INDEX_KEY=replace-with-the-existing-cpf-index-key
