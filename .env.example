# Use the Supabase shared pooler in transaction mode for Vercel functions.
# Get the exact hostname and username from Supabase Dashboard > Connect.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=verify-full

NODE_ENV=development
DATABASE_SSL_CA_BASE64=replace-with-base64-of-supabase-root-ca
PORT=3000
FRONTEND_URL=http://localhost:5173

# Generate unique secrets locally. Preserve the existing PII keys when migrating data.
JWT_SECRET=replace-with-at-least-32-random-characters
PII_ENCRYPTION_KEY=replace-with-the-existing-generated-fernet-key
CPF_INDEX_KEY=replace-with-the-existing-random-key
